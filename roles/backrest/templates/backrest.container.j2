# Von Ansible erzeugt - Aenderungen hier gehen beim naechsten Lauf verloren.
#
# Backrest ist ein FENSTER auf die Sicherungen, kein Werkzeug. Gesichert wird
# vom systemd-Timer aus der Rolle "backup"; hier wird nur hineingeschaut.
#
# Sein eigener Zustand (Repository-Definition, Passwort, Ansichten) liegt in
# seinen Volumes und nicht im Playbook. Das ist hier vertretbar, weil NICHTS
# davon abhaengt: Geht die Konfiguration verloren, bindet man das Repository
# neu ein und es ist nichts kaputt. Bei Arcane ist das anders - dessen
# Handlungen veraendern das echte System.
[Unit]
Description=Backrest - Fenster auf die restic-Sicherungen
After=network-online.target

[Container]
Image={{ helios_images.backrest }}
ContainerName=backrest
# Kein PublishPort: erreichbar nur ueber Caddy.
Network={{ helios_netzwerk }}.network

# Eigener Zustand von Backrest.
Volume=backrest-config:/config:Z
Volume=backrest-data:/data:Z
Volume=backrest-cache:/cache:Z

# Das Repository, SCHREIBGESCHUETZT. So ist "nur schauen" erzwungen und nicht
# bloss vereinbart - ein Fehlgriff in der Oberflaeche kann die Sicherungen
# nicht antasten.
#
# Zu den beiden SELinux-Schaltern, und der Unterschied ist hier entscheidend:
#
#   :Z  kennzeichnet den Pfad EXKLUSIV fuer diesen Container. Auf einem Pfad,
#       den auch der Host benutzt, ist das ein Fehler - der Timer auf dem Host
#       kaeme danach nicht mehr an sein eigenes Repository.
#   :z  kennzeichnet ihn GEMEINSAM. Mehrere Container und der Host duerfen.
#
# Am 20.09.2026 zunaechst ganz ohne Schalter versucht - dann kommt der
# Container gar nicht hinein ("Permission denied"). Also :z, und danach GEPRUEFT,
# dass das Sicherungsskript auf dem Host weiterhin laeuft.
Volume={{ helios_restic_verzeichnis }}:/repos:ro,z

Environment=BACKREST_PORT=0.0.0.0:9898
Environment=BACKREST_DATA=/data
Environment=BACKREST_CONFIG=/config/config.json
Environment=XDG_CACHE_HOME=/cache
Environment=TZ=Europe/Zurich

[Service]
Restart=always

[Install]
WantedBy=default.target
