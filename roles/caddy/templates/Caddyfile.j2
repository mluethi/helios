# Von Ansible erzeugt - Aenderungen hier gehen beim naechsten Lauf verloren.
#
# "tls internal": Caddy betreibt eine eigene Zertifizierungsstelle auf Helios.
# Kein ACME, kein API-Token, kein Internet noetig. Preis: Das Wurzelzertifikat
# muss einmal pro Geraet importiert werden. Siehe README.

{{ helios_dienste_namen.cockpit }} {
    tls internal
    # Cockpit laeuft auf dem Host, nicht im Container. "localhost" waere der
    # Caddy-Container selbst, taugt hier also nicht.
    #
    # host.containers.internal ist Podmans vorgesehener Weg zum Host: pasta
    # bildet 169.254.1.2 (--map-guest-addr) auf die Adresse des Hosts ab. Auf
    # dem Host kommt das als Verbindung 192.168.1.20 -> 192.168.1.20:9090 an,
    # also ueber Loopback - ungefiltert, ohne Firewall-Regel.
    #
    # NICHT den Hostnamen nehmen. pasta kopiert die Adresse des Hosts in
    # Podmans eigenes Netz; 192.168.1.20 ist dort eine eigene Adresse, und die
    # Verbindung verlaesst das Netz gar nicht. Ergebnis nach dem Kaltstart am
    # 22.11.2026: "dial tcp 192.168.1.20:9090: connect: connection refused".
    # Vom 19.09. bis dahin stand hier der Hostname und ging - vermutlich nur,
    # weil das Podman-Netz noch aus der Zeit vor dem Wechsel aufs Kabel stammte.
    #
    # Die bekannte Schwaeche: pasta merkt sich die Adresse des Hosts beim Start
    # (podman#24970). Wechselt sie im Betrieb - wie am 19.09. vom WLAN aufs
    # Kabel -, endet 169.254.1.2 im Leeren ("i/o timeout"). Abhilfe: Podman neu
    # starten, im Zweifel die ganze Maschine. Mit Kabel und DHCP-Reservierung
    # kommt das kaum noch vor.
    reverse_proxy host.containers.internal:9090
}

{{ helios_dienste_namen.homepage }} {
    tls internal
    # Container im selben Podman-Netzwerk finden sich ueber ihren Namen. Der
    # steht als ContainerName im Quadlet - ohne ihn hiesse er systemd-homepage.
    reverse_proxy homepage:3000
}

